#
# OrangeFox recovery product configuration for Xiaomi 15T (goya)
#

DEVICE_PATH := device/xiaomi/goya

$(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/launch_with_vendor_ramdisk.mk)

PRODUCT_DEVICE := goya
PRODUCT_BRAND := Xiaomi
PRODUCT_MODEL := 25069PTEBG
PRODUCT_MANUFACTURER := Xiaomi
PRODUCT_NAME := omni_goya

# BoardConfig.mk cannot assign PRODUCT_* variables: the build system marks them
# readonly after product configuration. Soong namespaces belong here.
PRODUCT_SOONG_NAMESPACES += $(DEVICE_PATH)

PRODUCT_USE_DYNAMIC_PARTITIONS := true
PRODUCT_USE_VIRTUAL_AB := true
PRODUCT_VIRTUAL_AB_OTA := true
PRODUCT_VIRTUAL_AB_COMPRESSION := true

# OrangeFox 14.1 is Android 14 based; keep the recovery build system at its
# highest supported SystemSDK even though the stock firmware is Android 16.
PRODUCT_SHIPPING_API_LEVEL := 34

PRODUCT_PROPERTY_OVERRIDES += \
    ro.product.device=goya \
    ro.product.model=25069PTEBG \
    ro.product.brand=Xiaomi \
    ro.product.vendor.marketname=Xiaomi 15T \
    ro.board.platform=mt6899 \
    ro.boot.dynamic_partitions=true \
    ro.build.ab_update=true \
    ro.virtual_ab.enabled=true \
    ro.virtual_ab.userspace.snapshots.enabled=true \
    ro.virtual_ab.compression.enabled=true \
    ro.virtual_ab.io_uring.enabled=true \
    ro.crypto.metadata_init_delete_all_keys.enabled=true \
    ro.recovery.usb.vid=18D1 \
    ro.recovery.usb.adb.pid=D001 \
    ro.recovery.usb.fastboot.pid=4EE0

# Recovery userspace. The stock MediaTek AIDL BootControl service (kept in
# the platform fragment) owns slot switching; no HIDL boot HAL is built here.
PRODUCT_PACKAGES += \
    android.hardware.health@2.1-impl \
    android.hardware.health@2.1-impl.recovery \
    android.hardware.health@2.1-service \
    android.hardware.health@2.1-service.rc \
    create_pl_dev \
    create_pl_dev.recovery \
    fastbootd \
    fsck.erofs \
    fsck.f2fs \
    lpunpack \
    make_f2fs \
    snapuserd \
    snapuserd_ramdisk \
    libgoya_libcxx_compat

PRODUCT_PACKAGES_DEBUG += \
    bootctrl \
    bootctl \
    logcat

# fastbootd waits for android.hardware.health.IHealth/default before it opens
# the fastboot FunctionFS endpoint. The compact stock recovery binary is
# started by init.recovery.mt6899.rc as health-aidl with the recovery SELinux
# domain; the stock rc cannot be used because class hal and the
# hal_health_default domain do not exist in this recovery.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/prebuilt/health/android.hardware.health-service.example_recovery:recovery/root/system/bin/android.hardware.health-service.example_recovery

# Recovery init / configuration. These files are also present below
# recovery/root; the explicit copies document what must end up in the
# OrangeFox fragment and make the dependency visible to PRODUCT_COPY_FILES.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/recovery/root/init.recovery.bootctl.rc:recovery/root/init.recovery.bootctl.rc \
    $(DEVICE_PATH)/recovery/root/init.recovery.keymint.rc:recovery/root/init.recovery.keymint.rc \
    $(DEVICE_PATH)/recovery/root/init.recovery.mt6899.rc:recovery/root/init.recovery.mt6899.rc \
    $(DEVICE_PATH)/recovery/root/init.recovery.project.rc:recovery/root/init.recovery.project.rc \
    $(DEVICE_PATH)/recovery/root/init.recovery.usb.rc:recovery/root/init.recovery.usb.rc \
    $(DEVICE_PATH)/recovery/root/system/bin/load-touch-modules.sh:recovery/root/system/bin/load-touch-modules.sh \
    $(DEVICE_PATH)/recovery/root/system/bin/wait-touch-service.sh:recovery/root/system/bin/wait-touch-service.sh \
    $(DEVICE_PATH)/recovery/root/system/bin/load-haptics-module.sh:recovery/root/system/bin/load-haptics-module.sh \
    $(DEVICE_PATH)/recovery/root/system/bin/magisk-addon-setup.sh:recovery/root/system/bin/magisk-addon-setup.sh \
    $(DEVICE_PATH)/recovery/root/system/etc/recovery.fstab:recovery/root/system/etc/recovery.fstab \
    $(DEVICE_PATH)/recovery/root/system/etc/twrp.flags:recovery/root/system/etc/twrp.flags \
    $(DEVICE_PATH)/recovery/root/first_stage_ramdisk/fstab.mt6899:recovery/root/first_stage_ramdisk/fstab.mt6899

# Recovery blobs (stock vendor_dlkm modules, ODM touch firmware/HAL, MiTEE
# KeyMint/Gatekeeper/Weaver and NXP Weaver). The file is generated by
# tools/generate-blobs-mk.sh after importing a phone dump; a missing file
# simply produces a Stage 1 image without touch/decrypt.
-include $(DEVICE_PATH)/proprietary/blobs.mk
