--- a/KeystoreInfo.cpp
+++ b/KeystoreInfo.cpp
@@ -27,7 +27,125 @@
 #include <algorithm>
 #include <string>
 #include <sqlite3.h>
+#include <dirent.h>
+#include <stdint.h>
+#include <sys/stat.h>
+#include <fstream>
 #include "KeystoreInfo.hpp"
+
+namespace {
+
+uint32_t readBigEndian32(const std::string& data, size_t offset) {
+	return (static_cast<uint32_t>(static_cast<uint8_t>(data[offset])) << 24) |
+		(static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 1])) << 16) |
+		(static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 2])) << 8) |
+		static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 3]));
+}
+
+bool readFileToString(const std::string& path, std::string* data) {
+	std::ifstream file(path, std::ios::binary);
+	if (!file)
+		return false;
+	std::ostringstream contents;
+	contents << file.rdbuf();
+	*data = contents.str();
+	return true;
+}
+
+bool regularFileExists(const std::string& path) {
+	struct stat st;
+	return stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
+
+std::string stripLeadingZeros(const std::string& value) {
+	size_t first = value.find_first_not_of('0');
+	if (first == std::string::npos)
+		return "0";
+	return value.substr(first);
+}
+
+bool getPasswordDataHeader(const std::string& pwd, std::string* header) {
+	if (pwd.size() < 11)
+		return false;
+	uint32_t salt_len = readBigEndian32(pwd, 7);
+	size_t header_len = 11 + static_cast<size_t>(salt_len);
+	if (pwd.size() < header_len)
+		return false;
+	*header = pwd.substr(0, header_len);
+	return true;
+}
+
+bool hasGatekeeperHandle(const std::string& pwd) {
+	if (pwd.size() < 11)
+		return false;
+	uint32_t salt_len = readBigEndian32(pwd, 7);
+	size_t handle_len_offset = 11 + static_cast<size_t>(salt_len);
+	if (pwd.size() < handle_len_offset + 4)
+		return false;
+	uint32_t handle_len = readBigEndian32(pwd, handle_len_offset);
+	return handle_len > 0 &&
+		pwd.size() >= handle_len_offset + 4 + static_cast<size_t>(handle_len);
+}
+
+// Some devices keep a Gatekeeper/secdis LSKF protector alongside the Weaver
+// protector. Recovery can unlock the secdis protector without the secure
+// element and OMAPI stack, so prefer it when it protects the same LSKF (the
+// .pwd scrypt parameters and salt match) and has its own spblob state.
+std::string findSecdiscFallback(userid_t user_id, const std::string& handle) {
+	if (handle.empty())
+		return "";
+	const std::string spblob_dir = "/data/system_de/" +
+		std::to_string(user_id) + "/spblob/";
+	if (!regularFileExists(spblob_dir + handle + ".weaver") &&
+			!regularFileExists(spblob_dir + "0" + handle + ".weaver"))
+		return "";
+
+	std::string current_pwd;
+	if (!readFileToString(spblob_dir + handle + ".pwd", &current_pwd) &&
+			!readFileToString(spblob_dir + "0" + handle + ".pwd", &current_pwd))
+		return "";
+	std::string current_header;
+	if (!getPasswordDataHeader(current_pwd, &current_header))
+		return "";
+
+	DIR* dir = opendir(spblob_dir.c_str());
+	if (dir == nullptr)
+		return "";
+
+	std::string fallback;
+	struct dirent* entry;
+	while ((entry = readdir(dir)) != nullptr) {
+		std::string name = entry->d_name;
+		if (name.size() <= 4 ||
+				name.compare(name.size() - 4, 4, ".pwd") != 0)
+			continue;
+
+		std::string stem = name.substr(0, name.size() - 4);
+		std::string candidate_handle = stripLeadingZeros(stem);
+		if (candidate_handle == handle)
+			continue;
+		if (!regularFileExists(spblob_dir + stem + ".secdis") ||
+				!regularFileExists(spblob_dir + stem + ".spblob") ||
+				regularFileExists(spblob_dir + stem + ".weaver"))
+			continue;
+
+		std::string candidate_pwd;
+		if (!readFileToString(spblob_dir + name, &candidate_pwd))
+			continue;
+		std::string candidate_header;
+		if (!getPasswordDataHeader(candidate_pwd, &candidate_header) ||
+				candidate_header != current_header ||
+				!hasGatekeeperHandle(candidate_pwd))
+			continue;
+
+		fallback = candidate_handle;
+		break;
+	}
+	closedir(dir);
+	return fallback;
+}
+
+} // namespace
 
