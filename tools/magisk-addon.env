# Magisk addon placement, shared by the vendor_boot repacker and the recovery
# callback.
#
# The goya bootloader bootloops when the combined vendor ramdisk exceeds about
# 64,000,000 bytes. The current platform + recovery fragments use 63,666,927
# bytes, so the Magisk installer APK is stored in the unused tail of the
# 112 MiB vendor_boot partition instead of the ramdisk.
#
# The offset is page aligned and well above the largest possible mkbootimg
# output (64 MB ramdisk plus headers, DTB and ramdisk table). The APK is
# covered by the AVB hash footer, so the partition still verifies.
MAGISK_ADDON_APK_NAME="Magisk-v30.7.apk"
MAGISK_ADDON_OFFSET=80003072
MAGISK_ADDON_SHA256="e0d32d2123532860f97123d927b1bb86c4e08e6fd8a48bfc6b5bee0afae9ebd5"
MAGISK_ADDON_VERSION="30.7"
