# Keep the stock MediaTek AIDL BootControl implementation from the platform
# ramdisk fragment. Goya's stock image can ship either the mtk_recovery or the
# mediatek_recovery module name; start both definitions and let the one that
# exists register android.hardware.boot.IBootControl/default.
service vendor.boot-mtk /system/bin/hw/android.hardware.boot-service.mtk_recovery
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64
    setenv LD_PRELOAD /system/lib64/libgoya_libcxx_compat.so
    seclabel u:r:recovery:s0
    interface aidl android.hardware.boot.IBootControl/default

service vendor.boot-mediatek /system/bin/hw/android.hardware.boot-service.mediatek_recovery
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64
    setenv LD_PRELOAD /system/lib64/libgoya_libcxx_compat.so
    seclabel u:r:recovery:s0
    interface aidl android.hardware.boot.IBootControl/default
